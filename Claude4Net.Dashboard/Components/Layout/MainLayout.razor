@inherits LayoutComponentBase
@using Claude4Net.Dashboard.Client.Components

<div class="d-flex min-vh-100" style="background-color: var(--bg-main);">
    <!-- Left 56px Slim Activity Dock -->
    <ActivityDock ApprovalsBadgeCount="3" CurrentMode="Orchestrator" />

    <!-- Main Content Area -->
    <div class="flex-grow-1 d-flex flex-column" style="min-width: 0;">
        <!-- Top Telemetry Ribbon -->
        <header class="py-2 px-4 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center" style="background: rgba(17, 24, 39, 0.7); backdrop-filter: blur(10px); z-index: 100;">
            <div class="d-flex align-items-center gap-3">
                <span class="badge badge-neon-cyan px-2 py-1"><i class="bi bi-terminal-fill me-1"></i> Claude4Net Runtime</span>
                <span class="text-secondary font-monospace small">|</span>
                <span class="text-secondary font-monospace small"><i class="bi bi-shield-lock-fill text-emerald me-1" style="color: var(--neon-emerald);"></i> Guardrails: ACTIVE</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <span class="badge badge-neon-emerald px-2 py-1"><span class="pulse-dot me-1"></span> SIGNALR STREAMING</span>
                <a href="https://github.com/Terkiss/Claude4Net" target="_blank" class="btn btn-sm btn-outline-secondary border-opacity-50 text-secondary">
                    <i class="bi bi-github me-1"></i> GitHub
                </a>
            </div>
        </header>

        <!-- Body Content -->
        <main class="flex-grow-1 p-4 overflow-auto">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" class="position-fixed bottom-0 end-0 m-3 p-3 bg-danger text-white rounded-3 shadow-lg" style="display: none; z-index: 9999;">
    <span>An unhandled error has occurred.</span>
    <a href="." class="reload text-white text-decoration-underline ms-2">Reload</a>
    <a class="dismiss text-white ms-2" style="cursor: pointer;">🗙</a>
</div>
