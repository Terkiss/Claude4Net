@page "/verification"
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Verification</PageTitle>

<h1>Verification Gates</h1>
<p>Review and approve command executions and spec coordinate gates.</p>

<div class="mt-3">
    <pre class="bg-dark text-light p-3">@_output</pre>
</div>

@code {
    private string _output = "Verification gate management commands will be routed here.";

    public async ValueTask DisposeAsync()
    {
        await Task.CompletedTask;
    }
}
