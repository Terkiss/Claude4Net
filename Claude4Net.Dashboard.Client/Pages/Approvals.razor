@page "/approvals"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using Claude4Net.SDK.Telemetry
@using Claude4Net.Dashboard.Client.Components
@implements IAsyncDisposable
@inject NavigationManager Navigation

<PageTitle>Master Approvals Queue</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-light mb-0"><i class="bi bi-shield-check text-warning me-2"></i> Master Approvals Queue</h4>
            <small class="text-muted font-monospace">Tier 3 High-Risk Operations & Prime Directive Checkpoint Gate</small>
        </div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshApprovals">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
        </button>
    </div>

    <ApprovalsQueue Approvals="_approvals" OnApprove="HandleApprove" OnReject="HandleReject" />
</div>

@code {
    private HubConnection? _hubConnection;
    private List<MasterApprovalItemDto> _approvals = new();

    protected override async Task OnInitializedAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/controlPlaneHub"))
            .WithAutomaticReconnect()
            .Build();

        await _hubConnection.StartAsync();
        await RefreshApprovals();
    }

    private async Task RefreshApprovals()
    {
        if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
        {
            try
            {
                var list = await _hubConnection.InvokeAsync<List<MasterApprovalItemDto>>("GetPendingApprovals");
                if (list != null)
                {
                    _approvals = list;
                }
            }
            catch { }
        }
    }

    private async Task HandleApprove(string taskId)
    {
        if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
        {
            await _hubConnection.InvokeAsync<bool>("ApproveTask", taskId);
            var item = _approvals.FirstOrDefault(a => a.TaskId == taskId);
            if (item != null) item.Status = "Approved";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleReject(string taskId)
    {
        if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
        {
            await _hubConnection.InvokeAsync<bool>("RejectTask", taskId, "Rejected by Master");
            var item = _approvals.FirstOrDefault(a => a.TaskId == taskId);
            if (item != null) item.Status = "Rejected";
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
