@page "/approvals"
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject NavigationManager Navigation

<PageTitle>Approval Queue</PageTitle>

<div class="container mt-4">
    <h3><i class="bi bi-shield-check"></i> Approval Queue</h3>
    <hr />

    @if (pendingApprovals.Count == 0)
    {
        <div class="alert alert-info">
            No pending approval requests.
        </div>
    }
    else
    {
        @foreach (var request in pendingApprovals)
        {
            <div class="card mb-3 border-warning">
                <div class="card-header bg-warning text-dark d-flex justify-content-between">
                    <span><strong>Request ID:</strong> @request.Id</span>
                    <span class="badge bg-dark">Pending</span>
                </div>
                <div class="card-body">
                    <h5 class="card-title">User Approval Required</h5>
                    <p class="card-text">@request.Message</p>

                    <div class="mt-3">
                        <label class="form-label">Reason (optional):</label>
                        <input type="text" class="form-control mb-2" @bind="request.Reason" placeholder="Why are you approving/denying?">
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-success" @onclick="() => Respond(request, true)">
                            Approve
                        </button>
                        <button class="btn btn-danger" @onclick="() => Respond(request, false)">
                            Deny
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private HubConnection? hubConnection;
    private List<ApprovalRequest> pendingApprovals = new();

    private class ApprovalRequest
    {
        public string Id { get; set; } = "";
        public string Message { get; set; } = "";
        public string? Reason { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/agentHub"))
            .Build();

        hubConnection.On<string, string>("ReceiveApprovalRequest", (id, message) =>
        {
            if (!pendingApprovals.Any(a => a.Id == id))
            {
                pendingApprovals.Add(new ApprovalRequest { Id = id, Message = message });
                InvokeAsync(StateHasChanged);
            }
        });

        hubConnection.On<string, bool, string?>("ApprovalResponded", (id, approved, reason) =>
        {
            pendingApprovals.RemoveAll(a => a.Id == id);
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    private async Task Respond(ApprovalRequest request, bool approved)
    {
        if (hubConnection is not null)
        {
            await hubConnection.SendAsync("RespondToApproval", request.Id, approved, request.Reason);
            pendingApprovals.Remove(request);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
