@page "/skills"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using Claude4Net.Dashboard.Client.Models
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Skills Management</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-light mb-0"><i class="bi bi-gear-wide-connected text-cyan me-2" style="color: var(--neon-cyan);"></i> Autonomous Skill Registry & SkillOpt</h4>
            <small class="text-muted font-monospace">Self-Evolving Agent Skills, Benchmark Evaluations & Mutation Proposals</small>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm @(activeTab == "registered" ? "btn-primary font-monospace" : "btn-outline-secondary")" @onclick='() => SetActiveTab("registered")'>
                <i class="bi bi-collection me-1"></i> Registered Skills (@skills.Count)
            </button>
            <button type="button" class="btn btn-sm @(activeTab == "proposals" ? "btn-primary font-monospace" : "btn-outline-secondary")" @onclick='() => SetActiveTab("proposals")'>
                <i class="bi bi-lightbulb me-1"></i> Evolution Proposals (@proposals.Count)
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary font-monospace" @onclick="LoadSkills" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Loading...</span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise me-1"></i><span>Refresh</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger font-monospace small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success font-monospace small" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @successMessage
        </div>
    }

    @if (isLoading && skills.Count == 0 && proposals.Count == 0)
    {
        <div class="cyber-card p-5 text-center">
            <div class="spinner-border text-info mb-3" role="status"></div>
            <div class="text-muted small font-monospace">Loading skill registry and evolution pipeline...</div>
        </div>
    }
    else if (activeTab == "registered")
    {
        <div class="cyber-card p-3">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                <span class="fw-bold text-light small"><i class="bi bi-cpu me-1"></i> Active Agent Skills (@skills.Count)</span>
                <span class="badge badge-neon-cyan font-monospace">Hot-Reloadable</span>
            </div>

            @if (skills.Count == 0)
            {
                <div class="p-4 text-center text-muted font-monospace small">No registered skills found in .agents/skills/</div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var skill in skills)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="p-3 rounded h-100 d-flex flex-column justify-content-between" style="background: rgba(14, 19, 28, 0.9); border: 1px solid rgba(255,255,255,0.06);">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="text-info fw-bold font-monospace mb-0 text-truncate">@skill.DisplayName</h6>
                                        <span class="badge bg-dark border border-secondary border-opacity-50 text-muted font-monospace" style="font-size: 0.68rem;">@skill.Id</span>
                                    </div>
                                    <p class="text-light small mb-3 font-monospace" style="font-size: 0.82rem; min-height: 40px;">@skill.SourcePath</p>
                                </div>
                                <div>
                                    <div class="d-flex justify-content-between small text-muted font-monospace pt-2 border-top border-secondary border-opacity-10">
                                        <span>Score: <span class="text-info">@skill.Metrics.AverageScore.ToString("F1")</span></span>
                                        <span>Success: <span class="text-emerald" style="color: var(--neon-emerald);">@skill.Metrics.SuccessCount</span></span>
                                        <span>Fail: <span class="text-danger">@skill.Metrics.FailureCount</span></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (activeTab == "proposals")
    {
        <div class="cyber-card p-3">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                <span class="fw-bold text-light small"><i class="bi bi-lightbulb me-1"></i> SkillOpt Mutation Proposals (@proposals.Count)</span>
                <span class="badge badge-neon-purple font-monospace">Autonomous Evolution</span>
            </div>

            @if (proposals.Count == 0)
            {
                <div class="p-4 text-center text-muted font-monospace small">No pending mutation proposals at this time.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                        <thead>
                            <tr class="text-muted small border-secondary border-opacity-25 font-monospace">
                                <th>SKILL ID</th>
                                <th>TITLE</th>
                                <th>RATIONALE</th>
                                <th>STATUS</th>
                                <th class="text-end">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prop in proposals)
                            {
                                <tr class="border-secondary border-opacity-10">
                                    <td><code class="text-info fw-bold font-monospace">@prop.SkillId</code></td>
                                    <td class="text-light small font-monospace">@prop.Title</td>
                                    <td class="text-muted small font-monospace">@prop.Rationale</td>
                                    <td><span class="badge bg-dark border border-secondary border-opacity-50 text-muted font-monospace">@prop.Status</span></td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-success font-monospace py-0 px-2" @onclick="() => ApproveProposal(prop.Id)" disabled="@isProcessing" style="font-size: 0.75rem;">
                                                <i class="bi bi-check-lg me-1"></i> Apply
                                            </button>
                                            <button type="button" class="btn btn-outline-danger font-monospace py-0 px-2" @onclick="() => RejectProposal(prop.Id)" disabled="@isProcessing" style="font-size: 0.75rem;">
                                                <i class="bi bi-x-lg me-1"></i> Reject
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private HubConnection? hubConnection;
    private List<SkillRegistryRecordDto> skills = new();
    private List<SkillProposalRecordDto> proposals = new();
    private string activeTab = "registered";
    private bool isLoading = true;
    private bool isProcessing = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await EnsureConnectedAsync();
        await LoadSkills();
    }

    private async Task EnsureConnectedAsync()
    {
        if (hubConnection == null)
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/controlPlaneHub"))
                .WithAutomaticReconnect()
                .Build();
        }

        if (hubConnection.State == HubConnectionState.Disconnected)
        {
            try
            {
                await hubConnection.StartAsync();
            }
            catch (Exception ex)
            {
                errorMessage = $"Connection error: {ex.Message}";
            }
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private async Task LoadSkills()
    {
        await EnsureConnectedAsync();
        if (hubConnection is null || hubConnection.State != HubConnectionState.Connected)
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var state = await hubConnection.InvokeAsync<SkillControlPlaneState>("GetSkills");
            if (state != null)
            {
                skills = state.Skills ?? new List<SkillRegistryRecordDto>();
                proposals = state.Proposals ?? new List<SkillProposalRecordDto>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to fetch skills data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApproveProposal(string proposalId)
    {
        await EnsureConnectedAsync();
        if (hubConnection is null || hubConnection.State != HubConnectionState.Connected) return;

        isProcessing = true;
        try
        {
            var res = await hubConnection.InvokeAsync<CommandResult>("ApproveSkillProposal", proposalId);
            if (res != null && res.Success)
            {
                successMessage = $"Proposal {proposalId} applied successfully!";
                await LoadSkills();
            }
            else
            {
                errorMessage = res?.Error ?? "Failed to apply proposal";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Approval error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RejectProposal(string proposalId)
    {
        await EnsureConnectedAsync();
        if (hubConnection is null || hubConnection.State != HubConnectionState.Connected) return;

        isProcessing = true;
        try
        {
            var res = await hubConnection.InvokeAsync<CommandResult>("RejectSkillProposal", proposalId, "Rejected by User");
            if (res != null && res.Success)
            {
                successMessage = $"Proposal {proposalId} rejected.";
                await LoadSkills();
            }
            else
            {
                errorMessage = res?.Error ?? "Failed to reject proposal";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Rejection error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
