@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using Claude4Net.SDK.Telemetry
@using Claude4Net.Dashboard.Client.Components
@implements IAsyncDisposable
@inject NavigationManager Navigation

<PageTitle>Claude4Net Control Center</PageTitle>

<div class="container-fluid p-0">
    <!-- Top Terukirdo Supreme Orchestrator Ribbon -->
    <TerukirdoProtocolRibbon ProtocolVersion="v5.4" CurrentMode="Orchestrator" ActiveModel="Gemini-3.7-Flash" />

    <!-- Top 4 KPI Metrics Row -->
    <div class="row g-3 mb-4">
        <!-- 1. Active Agents -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card p-3 h-100 position-relative overflow-hidden">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small">Active Agents</span>
                        <h3 class="fw-bold font-monospace text-light my-1">@_tick.ActiveAgentsCount Active</h3>
                        <span class="small text-success font-monospace"><i class="bi bi-arrow-up-right me-1"></i>+4% <span class="text-muted">last 24h</span></span>
                    </div>
                    <div style="width: 45px; height: 45px;">
                        <svg viewBox="0 0 36 36" class="w-100 h-100">
                            <path class="text-secondary" stroke-width="3.8" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" opacity="0.2" />
                            <path class="text-info" stroke-dasharray="75, 100" stroke-width="3.8" stroke="currentColor" fill="none" stroke-linecap="round" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Tokens Used -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card p-3 h-100 position-relative overflow-hidden">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small">Tokens Used</span>
                        <h3 class="fw-bold font-monospace text-info my-1">@((_tick.TodayTotalTokens / 1_000_000.0).ToString("0.00"))M</h3>
                        <div class="small text-muted font-monospace">@_tick.TodayTotalTokens.ToString("N0") <span class="text-secondary">/ 5,000,000</span></div>
                    </div>
                    <div style="width: 65px; height: 35px;">
                        <svg viewBox="0 0 100 40" class="w-100 h-100">
                            <polyline points="0,35 15,28 30,32 45,18 60,25 75,12 90,18 100,5" fill="none" stroke="#00f0ff" stroke-width="2.5" stroke-linecap="round" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Total Cost -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card p-3 h-100 position-relative overflow-hidden">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small">Total Cost</span>
                        <h3 class="fw-bold font-monospace text-success my-1">$@_tick.TodayTotalCostUsd.ToString("F3")</h3>
                        <span class="small text-muted">Daily Burn Rate: <span class="text-success font-monospace">Optimal</span></span>
                    </div>
                    <div class="d-flex align-items-end gap-1" style="height: 35px;">
                        <div style="width: 6px; height: 15px; background: #10b981; border-radius: 2px;"></div>
                        <div style="width: 6px; height: 22px; background: #10b981; border-radius: 2px;"></div>
                        <div style="width: 6px; height: 18px; background: #10b981; border-radius: 2px;"></div>
                        <div style="width: 6px; height: 32px; background: #10b981; border-radius: 2px;"></div>
                        <div style="width: 6px; height: 26px; background: #10b981; border-radius: 2px;"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Avg Latency -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card p-3 h-100 position-relative overflow-hidden">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small">Avg Latency</span>
                        <h3 class="fw-bold font-monospace text-light my-1">@_tick.CurrentLatencyMs.ToString("0")ms</h3>
                        <span class="badge bg-dark border border-secondary text-info font-monospace" style="font-size: 0.68rem;">Stability 99.8%</span>
                    </div>
                    <div style="width: 65px; height: 35px;">
                        <svg viewBox="0 0 100 40" class="w-100 h-100">
                            <polyline points="0,20 20,22 40,18 60,25 80,19 100,20" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Center: Token & Cost Activity Heatmap + Hourly Drilldown -->
    <CalendarView HeatmapTiles="_heatmapTiles"
                  HourlyBuckets="_hourlyBuckets"
                  ProjectShares="_projectShares"
                  OnDateSelected="HandleDateSelected" />

    <!-- Bottom: Distributed Trace Waterfall + Orchestrator Thought Stream -->
    <div class="row g-3">
        <div class="col-12 col-xl-6">
            <TraceWaterfall Traces="_traces" />
        </div>
        <div class="col-12 col-xl-6">
            <ThoughtStream />
        </div>
    </div>
</div>

@code {
    private HubConnection? _hubConnection;
    private LiveTelemetryTickDto _tick = new()
    {
        ActiveAgentsCount = 5,
        TodayTotalTokens = 2415800,
        TodayTotalCostUsd = 14.285,
        CurrentLatencyMs = 120.0,
        ThroughputTokensPerSec = 450.0,
        ApprovalsBadgeCount = 3
    };
    private List<CalendarHeatmapTileDto> _heatmapTiles = new();
    private List<HourlyUsageBucketDto> _hourlyBuckets = new();
    private List<ProjectUsageShareDto> _projectShares = new();
    private List<RequestTraceSpanDto> _traces = new();
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/controlPlaneHub"))
            .WithAutomaticReconnect()
            .Build();

        await _hubConnection.StartAsync();
        await LoadInitialData();

        // Start live dynamic pulse ticker (every 1.5 seconds)
        _ = StartLiveTickerAsync(_cts.Token);
    }

    private async Task LoadInitialData()
    {
        if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
        {
            try
            {
                var tick = await _hubConnection.InvokeAsync<LiveTelemetryTickDto>("GetLiveTelemetryTick");
                if (tick != null) _tick = tick;

                var tiles = await _hubConnection.InvokeAsync<List<CalendarHeatmapTileDto>>("GetCalendarHeatmap", 90);
                if (tiles != null) _heatmapTiles = tiles;

                var shares = await _hubConnection.InvokeAsync<List<ProjectUsageShareDto>>("GetProjectShares");
                if (shares != null) _projectShares = shares;

                var traces = await _hubConnection.InvokeAsync<List<RequestTraceSpanDto>>("GetRecentTraces", 6);
                if (traces != null) _traces = traces;

                string todayIso = DateTime.UtcNow.ToString("yyyy-MM-dd");
                var hourly = await _hubConnection.InvokeAsync<List<HourlyUsageBucketDto>>("GetHourlyDrilldown", todayIso);
                if (hourly != null) _hourlyBuckets = hourly;
            }
            catch { }
        }
    }

    private async Task StartLiveTickerAsync(CancellationToken ct)
    {
        var rand = new Random();
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1.5));

        while (!ct.IsCancellationRequested && await timer.WaitForNextTickAsync(ct))
        {
            try
            {
                if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
                {
                    var live = await _hubConnection.InvokeAsync<LiveTelemetryTickDto>("GetLiveTelemetryTick", ct);
                    if (live != null)
                    {
                        // Add live incremental ticks for lively feel
                        _tick.TodayTotalTokens += rand.Next(80, 320);
                        _tick.TodayTotalCostUsd += Math.Round(rand.NextDouble() * 0.001, 4);
                        _tick.CurrentLatencyMs = Math.Max(95.0, Math.Min(180.0, _tick.CurrentLatencyMs + (rand.NextDouble() * 6.0 - 3.0)));
                        _tick.ApprovalsBadgeCount = live.ApprovalsBadgeCount;
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
            catch { }
        }
    }

    private async Task HandleDateSelected(string dateIso)
    {
        try
        {
            if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
            {
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(2));
                var hourly = await _hubConnection.InvokeAsync<List<HourlyUsageBucketDto>>("GetHourlyDrilldown", dateIso, cts.Token);
                if (hourly != null && hourly.Count > 0)
                {
                    _hourlyBuckets = hourly;
                }
                else
                {
                    long tok = _heatmapTiles.FirstOrDefault(t => t.DateIso == dateIso)?.TotalTokens ?? 0;
                    _hourlyBuckets = GenerateFallbackHourlyBuckets(dateIso, tok);
                }
            }
            else
            {
                long tok = _heatmapTiles.FirstOrDefault(t => t.DateIso == dateIso)?.TotalTokens ?? 0;
                _hourlyBuckets = GenerateFallbackHourlyBuckets(dateIso, tok);
            }
        }
        catch
        {
            long tok = _heatmapTiles.FirstOrDefault(t => t.DateIso == dateIso)?.TotalTokens ?? 0;
            _hourlyBuckets = GenerateFallbackHourlyBuckets(dateIso, tok);
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private static List<HourlyUsageBucketDto> GenerateFallbackHourlyBuckets(string dateIso, long totalTokens)
    {
        var list = new List<HourlyUsageBucketDto>();
        if (totalTokens <= 0)
        {
            for (int h = 0; h < 24; h++)
            {
                list.Add(new HourlyUsageBucketDto { Hour = h, TotalTokens = 0, TotalCostUsd = 0 });
            }
            return list;
        }

        double[] distribution = new double[24] {
            0.01, 0.01, 0.00, 0.00, 0.00, 0.01,
            0.02, 0.04, 0.07, 0.09, 0.10, 0.08,
            0.06, 0.09, 0.10, 0.09, 0.08, 0.06,
            0.04, 0.03, 0.01, 0.01, 0.00, 0.00
        };

        for (int h = 0; h < 24; h++)
        {
            long tok = (long)(totalTokens * distribution[h]);
            list.Add(new HourlyUsageBucketDto
            {
                Hour = h,
                TotalTokens = tok,
                TotalCostUsd = tok * 0.000005
            });
        }
        return list;
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();

        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
