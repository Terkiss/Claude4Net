@page "/providers"
@using Microsoft.AspNetCore.SignalR.Client
@using Claude4Net.Dashboard.Client.Models
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Providers</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="bi bi-cpu"></i> Providers Configuration</h3>
        <button class="btn btn-primary" @onclick="LoadProviders" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span> Loading...</span>
            }
            else
            {
                <i class="bi bi-arrow-clockwise"></i><span> Refresh</span>
            }
        </button>
    </div>
    <p>Manage model routing and provider descriptors.</p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
        </div>
    }

    @if (isLoading && providers.Count == 0)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading providers...</span>
            </div>
        </div>
    }
    else if (providers.Count == 0)
    {
        <div class="alert alert-info">
            No providers found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Label</th>
                        <th>Transport</th>
                        <th>Cost Score</th>
                        <th>Context Window</th>
                        <th>Endpoint</th>
                        <th>Health</th>
                        <th>Latency EMA</th>
                        <th>Success</th>
                        <th>Error</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var provider in providers)
                    {
                        <tr>
                            <td><code>@provider.Id</code></td>
                            <td>@provider.Label</td>
                            <td><span class="badge bg-secondary">@provider.TransportKind</span></td>
                            <td>@provider.CostScore</td>
                            <td>@provider.ContextWindowSize.ToString("N0")</td>
                            <td><small class="text-muted">@provider.Endpoint</small></td>
                            <td>
                                @if (provider.HealthStatus.Equals("Healthy", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success">Healthy</span>
                                }
                                else if (provider.HealthStatus.Equals("Degraded", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-warning text-dark">Degraded</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@provider.HealthStatus</span>
                                }
                            </td>
                            <td>@(provider.LatencyEma > 0 ? $"{provider.LatencyEma:F1}ms" : "N/A")</td>
                            <td><span class="text-success">@provider.SuccessCount</span></td>
                            <td><span class="text-danger">@provider.ErrorCount</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private HubConnection? hubConnection;
    private List<ProviderDescriptorDto> providers = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/controlPlaneHub"))
                .WithAutomaticReconnect()
                .Build();

            await hubConnection.StartAsync();
            await LoadProviders();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to connect to SignalR control plane: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task LoadProviders()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            if (hubConnection is not null)
            {
                var state = await hubConnection.InvokeAsync<ProviderControlPlaneState>("GetProviders");
                providers = state?.Providers ?? new List<ProviderDescriptorDto>();
            }
            else
            {
                errorMessage = "Hub connection is not established.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading providers: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
