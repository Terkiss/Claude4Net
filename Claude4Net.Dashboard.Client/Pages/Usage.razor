@page "/usage"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using Claude4Net.Dashboard.Client.Models
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Token Usage & Analytics</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-light mb-0"><i class="bi bi-graph-up text-cyan me-2" style="color: var(--neon-cyan);"></i> Token Usage & Performance Analytics</h4>
            <small class="text-muted font-monospace">Real-time LLM query throughput, tokens in/out, burn rate, and latency EMA</small>
        </div>
        <div class="d-flex gap-2 align-items-center mt-2 mt-sm-0">
            <input type="text" class="form-control form-control-sm bg-dark border-secondary border-opacity-50 text-light font-monospace" placeholder="Session ID (Optional)" @bind="sessionId" style="width: 220px;" />
            <button type="button" class="btn btn-sm btn-primary font-monospace px-3" @onclick="LoadUsage" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Loading...</span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise me-1"></i><span>Refresh</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger font-monospace small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        </div>
    }

    <!-- 4 KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card p-3 h-100">
                <span class="text-muted small font-monospace">Total API Calls</span>
                <h3 class="fw-bold font-monospace text-light my-1">@usageData.TotalCalls.ToString("N0")</h3>
                <span class="badge badge-neon-cyan font-monospace" style="font-size: 0.68rem;">Live Gateways</span>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card p-3 h-100">
                <span class="text-muted small font-monospace">Cumulative Cost (USD)</span>
                <h3 class="fw-bold font-monospace text-success my-1">$@usageData.TotalCost.ToString("F4")</h3>
                <span class="small text-muted font-monospace">Burn Rate: <span class="text-success">Optimal</span></span>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card p-3 h-100">
                <span class="text-muted small font-monospace">Latency EMA</span>
                <h3 class="fw-bold font-monospace text-light my-1">@usageData.LatencyEma.ToString("F1")ms</h3>
                <span class="badge badge-neon-emerald font-monospace" style="font-size: 0.68rem;">P95 Stable</span>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card p-3 h-100">
                <span class="text-muted small font-monospace">Total Tokens</span>
                <h3 class="fw-bold font-monospace text-info my-1">@((usageData.TotalInputTokens + usageData.TotalOutputTokens).ToString("N0"))</h3>
                <span class="small text-muted font-monospace">Input: @usageData.TotalInputTokens.ToString("N0")</span>
            </div>
        </div>
    </div>

    <!-- Models Breakdown Table -->
    <div class="cyber-card p-3">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
            <span class="fw-bold text-light small font-monospace"><i class="bi bi-pie-chart me-1"></i> Multi-Provider Model Breakdown</span>
            <span class="badge badge-neon-purple font-monospace">Antigravity Fleet</span>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                <thead>
                    <tr class="text-muted small border-secondary border-opacity-25 font-monospace">
                        <th>MODEL NAME</th>
                        <th>PROVIDER</th>
                        <th class="text-end">CALLS</th>
                        <th class="text-end">PROMPT TOKENS</th>
                        <th class="text-end">COMPLETION TOKENS</th>
                        <th class="text-end">TOTAL TOKENS</th>
                        <th class="text-end">AVG LATENCY</th>
                        <th class="text-end">EST. COST (USD)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (usageData.ModelMetrics == null || usageData.ModelMetrics.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4 font-monospace small">No model usage recorded for this filter.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var metric in usageData.ModelMetrics)
                        {
                            <tr class="border-secondary border-opacity-10">
                                <td>
                                    <span class="badge badge-neon-cyan font-monospace" style="font-size: 0.75rem;">@metric.Model</span>
                                </td>
                                <td><span class="badge bg-dark border border-secondary border-opacity-50 text-light font-monospace">@metric.Provider</span></td>
                                <td class="text-end text-light font-monospace">@metric.Calls.ToString("N0")</td>
                                <td class="text-end text-muted font-monospace">@metric.InputTokens.ToString("N0")</td>
                                <td class="text-end text-muted font-monospace">@metric.OutputTokens.ToString("N0")</td>
                                <td class="text-end text-info fw-bold font-monospace">@((metric.InputTokens + metric.OutputTokens).ToString("N0"))</td>
                                <td class="text-end text-light font-monospace">@(metric.LatencyEma > 0 ? $"{metric.LatencyEma:F1}ms" : "N/A")</td>
                                <td class="text-end text-success font-monospace">$@metric.Cost.ToString("F4")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private HubConnection? hubConnection;
    private UsageReadModelDto usageData = new();
    private string sessionId = string.Empty;
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await EnsureConnectedAsync();
        await LoadUsage();
    }

    private async Task EnsureConnectedAsync()
    {
        if (hubConnection == null)
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/controlPlaneHub"))
                .WithAutomaticReconnect()
                .Build();
        }

        if (hubConnection.State == HubConnectionState.Disconnected)
        {
            try
            {
                await hubConnection.StartAsync();
            }
            catch (Exception ex)
            {
                errorMessage = $"Connection error: {ex.Message}";
            }
        }
    }

    private async Task LoadUsage()
    {
        await EnsureConnectedAsync();
        if (hubConnection is null || hubConnection.State != HubConnectionState.Connected)
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var filter = string.IsNullOrWhiteSpace(sessionId) ? null : sessionId;
            var result = await hubConnection.InvokeAsync<UsageReadModelDto>("GetUsageReadModel", filter);
            usageData = result ?? new UsageReadModelDto();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to fetch usage analytics: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
