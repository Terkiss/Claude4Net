@page "/routines"
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Routines</PageTitle>

<h1>Automated Routines</h1>
<p>Manage and view your automated routines.</p>

<div>
    <button class="btn btn-primary" @onclick="LoadRoutines">Refresh Routines</button>
</div>

<div class="mt-3">
    <pre class="bg-dark text-light p-3">@_output</pre>
</div>

@code {
    private HubConnection? _hubConnection;
    private string _output = "Click 'Refresh Routines' to load.";

    protected override async Task OnInitializedAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/controlPlaneHub"))
            .Build();

        await _hubConnection.StartAsync();
        await LoadRoutines();
    }

    private async Task LoadRoutines()
    {
        if (_hubConnection is not null)
        {
            try
            {
                _output = await _hubConnection.InvokeAsync<string>("ExecuteCommand", "/routine list");
            }
            catch (Exception ex)
            {
                _output = $"Error: {ex.Message}";
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
