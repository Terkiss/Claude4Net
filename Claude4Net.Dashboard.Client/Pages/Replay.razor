@page "/replay"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using Claude4Net.Dashboard.Client.Models
@using System.Text.Json
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Time-Travel Session Replay</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-light mb-0"><i class="bi bi-clock-history text-info me-2"></i> Time-Travel Session Replay</h4>
            <small class="text-muted font-monospace">Event Sourcing State Reconstruction & Action Step Player</small>
        </div>
        <div class="d-flex gap-2 align-items-center mt-2 mt-sm-0">
            <div class="input-group input-group-sm" style="max-width: 320px;">
                <span class="input-group-text bg-dark border-secondary border-opacity-50 text-muted font-monospace">Session ID</span>
                <input type="text" class="form-control bg-dark border-secondary border-opacity-50 text-light font-monospace" @bind="targetSessionId" placeholder="sess-..." />
            </div>
            <button class="btn btn-sm btn-primary font-monospace px-3" @onclick="() => LoadSession(targetSessionId)" disabled="@(isLoading || string.IsNullOrWhiteSpace(targetSessionId))">
                <i class="bi bi-arrow-right-short me-1"></i> Load
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        </div>
    }

    @if (isLoading)
    {
        <div class="cyber-card p-5 text-center">
            <div class="spinner-border text-info mb-3" role="status"></div>
            <div class="text-muted small">Loading event stream and reconstructing checkpoints...</div>
        </div>
    }
    else if (events == null || events.Count == 0)
    {
        <div class="cyber-card p-5 text-center">
            <i class="bi bi-play-circle text-secondary mb-3" style="font-size: 2.5rem;"></i>
            <h5 class="text-light fw-bold">Time-Travel Player Ready</h5>
            <p class="text-muted small mb-0">Select a session from the <a href="sessions" class="text-info text-decoration-none">Sessions Observatory</a> or enter a Session ID above to replay execution history.</p>
        </div>
    }
    else
    {
        <!-- Slider Panel -->
        <div class="cyber-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-sliders text-cyan" style="color: var(--neon-cyan);"></i>
                    <span class="fw-bold text-light small">Time-Travel Scrubber</span>
                </div>
                <span class="badge badge-neon-cyan font-monospace" style="font-size: 0.85rem;">
                    Step @currentStep / @events.Count
                </span>
            </div>

            <input type="range" class="form-range" min="0" max="@events.Count" @bind-value="CurrentStep" @bind-value:event="oninput" style="height: 1.25rem;" />

            <div class="d-flex justify-content-between small text-muted font-monospace mt-1">
                <span>Step 0 (Initial Baseline)</span>
                <span>Step @events.Count (Latest State)</span>
            </div>
        </div>

        <div class="row g-3">
            <!-- Left Side: Event Timeline -->
            <div class="col-12 col-xl-5">
                <div class="cyber-card h-100 d-flex flex-column" style="max-height: 650px;">
                    <div class="cyber-card-header">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-list-ol text-primary"></i>
                            <span>Event Stream Timeline (@events.Count events)</span>
                        </div>
                    </div>
                    <div class="p-0 overflow-auto flex-grow-1">
                        <div class="list-group list-group-flush" style="background: transparent;">
                            <button type="button" class="list-group-item list-group-item-action p-3 border-secondary border-opacity-10 @(currentStep == 0 ? "bg-primary bg-opacity-25 text-white" : "bg-transparent text-muted")" @onclick="() => UpdateStep(0)">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold small text-light">0. Session Start Baseline</span>
                                </div>
                                <small class="d-block text-secondary">Initial workspace baseline snapshot.</small>
                            </button>

                            @for (int i = 0; i < events.Count; i++)
                            {
                                var index = i + 1;
                                var ev = events[i];
                                var isCurrent = currentStep == index;

                                <button type="button" class="list-group-item list-group-item-action p-3 border-secondary border-opacity-10 @(isCurrent ? "bg-info bg-opacity-20 text-white" : "bg-transparent text-muted")" @onclick="() => UpdateStep(index)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold small @(isCurrent ? "text-cyan" : "text-light") font-monospace">@index. @ev.EventType</span>
                                        <span class="badge bg-dark border border-secondary border-opacity-50 text-muted font-monospace">v@ev.Version</span>
                                    </div>
                                    <small class="d-block mt-1 @(isCurrent ? "text-light" : "text-secondary")">@ev.Summary</small>
                                    <small class="d-block font-monospace text-dim" style="font-size: 0.72rem;">
                                        @ev.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")
                                    </small>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: State Reconstruction -->
            <div class="col-12 col-xl-7">
                <div class="cyber-card h-100 d-flex flex-column" style="max-height: 650px;">
                    <div class="cyber-card-header">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-box-seam text-success"></i>
                            <span>State Reconstruction Snapshot</span>
                        </div>
                        @if (reconstructedState != null)
                        {
                            <span class="badge badge-neon-emerald font-monospace">Version: @reconstructedState.LastVersion</span>
                        }
                    </div>
                    <div class="p-3 overflow-auto flex-grow-1" style="background: rgba(9, 12, 18, 0.75);">
                        @if (reconstructedState == null)
                        {
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-hourglass-split d-block fs-2 mb-2 opacity-50"></i>
                                <span>No reconstructed state loaded. Use slider or click an event to reconstruct.</span>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <span class="text-muted small uppercase font-monospace d-block mb-1">Active Task</span>
                                <div class="p-2 rounded font-monospace small text-light" style="background: #111827; border: 1px solid rgba(255,255,255,0.08);">
                                    @(string.IsNullOrWhiteSpace(reconstructedState.CurrentTask) ? "(No Active Task)" : reconstructedState.CurrentTask)
                                </div>
                            </div>

                            <span class="text-muted small uppercase font-monospace d-block mb-2">Reconstructed Conversation History</span>

                            @if (reconstructedState.HistoryJson == null || reconstructedState.HistoryJson.Count == 0)
                            {
                                <div class="text-center text-muted p-4 border border-secondary border-opacity-25 rounded" style="background: #111827;">
                                    No history messages recorded up to this point.
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var historyStr in reconstructedState.HistoryJson)
                                    {
                                        var messageElement = ParseJson(historyStr);
                                        var role = GetProperty(messageElement, "role");
                                        var contentElement = messageElement.GetProperty("content");

                                        @if (role.Equals("user", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="d-flex flex-column align-items-start">
                                                <span class="badge bg-primary mb-1">User Prompt</span>
                                                <div class="p-2 rounded w-100 text-light small" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3);">
                                                    @if (contentElement.ValueKind == JsonValueKind.String)
                                                    {
                                                        <span style="white-space: pre-wrap;">@contentElement.GetString()</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else if (role.Equals("assistant", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="d-flex flex-column align-items-end">
                                                <span class="badge badge-neon-emerald mb-1">Assistant Turn</span>
                                                <div class="p-2 rounded w-100 text-light small" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3);">
                                                    <span style="white-space: pre-wrap;">@contentElement.GetString()</span>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? SessionId { get; set; }

    private HubConnection? hubConnection;
    private string targetSessionId = string.Empty;
    private string currentSessionId = string.Empty;
    private List<ReplayEventDto> events = new();
    private ReconstructedStateDto? reconstructedState;
    private int currentStep = 0;
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    public int CurrentStep
    {
        get => currentStep;
        set
        {
            if (currentStep != value)
            {
                currentStep = value;
                _ = UpdateStep(value);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/controlPlaneHub"))
            .WithAutomaticReconnect()
            .Build();

        try
        {
            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Connection error: {ex.Message}";
        }

        if (!string.IsNullOrWhiteSpace(SessionId))
        {
            targetSessionId = SessionId;
            await LoadSession(SessionId);
        }
    }

    private async Task LoadSession(string sId)
    {
        if (hubConnection is null || hubConnection.State != HubConnectionState.Connected)
        {
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;
        currentSessionId = sId;

        try
        {
            var result = await hubConnection.InvokeAsync<List<ReplayEventDto>>("GetSessionEvents", sId);
            events = result ?? new List<ReplayEventDto>();

            currentStep = events.Count;
            if (events.Count > 0)
            {
                await UpdateStep(currentStep);
            }
            else
            {
                reconstructedState = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load events for session {sId}: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UpdateStep(int step)
    {
        currentStep = step;
        if (hubConnection is null || hubConnection.State != HubConnectionState.Connected || string.IsNullOrEmpty(currentSessionId))
        {
            return;
        }

        try
        {
            reconstructedState = await hubConnection.InvokeAsync<ReconstructedStateDto>("ReplaySessionUpToVersion", currentSessionId, step);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to replay to step {step}: {ex.Message}";
        }
    }

    private JsonElement ParseJson(string json)
    {
        try
        {
            return JsonDocument.Parse(json).RootElement;
        }
        catch
        {
            return JsonDocument.Parse("{}").RootElement;
        }
    }

    private string GetProperty(JsonElement element, string propName)
    {
        if (element.ValueKind == JsonValueKind.Object && element.TryGetProperty(propName, out var prop))
        {
            return prop.GetString() ?? string.Empty;
        }
        return string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
