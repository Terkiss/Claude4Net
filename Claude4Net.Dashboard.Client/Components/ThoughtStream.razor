@using Microsoft.AspNetCore.SignalR.Client
@using Claude4Net.SDK.Events
@using System.Text.Json
@implements IAsyncDisposable
@inject NavigationManager Navigation

<div class="thought-stream border rounded p-3 bg-light" style="height: 600px; overflow-y: auto;">
    <h5>Thinking Stream</h5>
    @if (events.Count == 0)
    {
        <p class="text-muted italic">Waiting for events...</p>
    }
    else
    {
        @foreach (var evt in events)
        {
            <div class="event-item mb-2 border-bottom pb-2">
                <div class="d-flex justify-content-between">
                    <span class="badge @GetBadgeClass(evt)">@evt.EventType</span>
                    <small class="text-muted">@evt.Timestamp.ToString("HH:mm:ss.fff")</small>
                </div>
                <div class="event-content mt-1">
                    @GetEventSummary(evt)
                </div>
            </div>
        }
    }
</div>

@code {
    private HubConnection? hubConnection;
    private List<IAgentEvent> events = new();

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/agentHub"))
            .Build();

        hubConnection.On<JsonElement>("ReceiveEvent", (json) =>
        {
            // Note: In a real app, we'd use a custom JsonConverter for polymorphic deserialization
            // Here we'll do a simple mapping for the demo/MVP
            var eventType = json.GetProperty("EventType").GetString();
            IAgentEvent? evt = eventType switch
            {
                "UserPromptReceived" => System.Text.Json.JsonSerializer.Deserialize<UserPromptReceivedEvent>(json.GetRawText()),
                "AgentThought" => System.Text.Json.JsonSerializer.Deserialize<AgentThoughtEvent>(json.GetRawText()),
                "ToolCalled" => System.Text.Json.JsonSerializer.Deserialize<ToolCalledEvent>(json.GetRawText()),
                "ToolResult" => System.Text.Json.JsonSerializer.Deserialize<ToolResultEvent>(json.GetRawText()),
                "FinalResponseGenerated" => System.Text.Json.JsonSerializer.Deserialize<FinalResponseGeneratedEvent>(json.GetRawText()),
                _ => null
            };

            if (evt != null)
            {
                events.Add(evt);
                if (events.Count > 100) events.RemoveAt(0);
                InvokeAsync(StateHasChanged);
            }
        });

        await hubConnection.StartAsync();
    }

    private string GetBadgeClass(IAgentEvent evt) => evt.EventType switch
    {
        "UserPromptReceived" => "bg-primary",
        "AgentThought" => "bg-info",
        "ToolCalled" => "bg-warning text-dark",
        "ToolResult" => "bg-success",
        "FinalResponseGenerated" => "bg-secondary",
        _ => "bg-dark"
    };

    private string GetEventSummary(IAgentEvent evt) => evt switch
    {
        UserPromptReceivedEvent up => up.Prompt,
        AgentThoughtEvent at => at.Thought,
        ToolCalledEvent tc => $"Called {tc.ToolName}({tc.Arguments})",
        ToolResultEvent tr => $"Result: {tr.Result}",
        FinalResponseGeneratedEvent fr => fr.Response,
        _ => "Unknown event"
    };

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
