@using Microsoft.AspNetCore.SignalR.Client
@using Claude4Net.SDK.Events
@using System.Text.Json
@implements IAsyncDisposable
@inject NavigationManager Navigation

<div class="cyber-card h-100 d-flex flex-column" style="min-height: 520px;">
    <!-- Stream Header -->
    <div class="cyber-card-header">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-terminal-fill text-cyan" style="color: var(--neon-cyan);"></i>
            <span>Live Thinking & Event Stream</span>
            <span class="pulse-dot ms-1"></span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge badge-neon-cyan font-monospace">@events.Count Events</span>
            <button class="btn btn-sm btn-outline-secondary border-0 text-secondary" @onclick="ClearEvents" title="Clear Stream">
                <i class="bi bi-trash3"></i>
            </button>
        </div>
    </div>

    <!-- Event List Body -->
    <div class="p-3 flex-grow-1 overflow-auto font-monospace" style="max-height: 580px; background: rgba(8, 12, 20, 0.95);">
        @if (events.Count == 0)
        {
            <div class="text-center py-5">
                <div class="spinner-border mb-3" style="color: var(--neon-cyan); width: 2rem; height: 2rem;" role="status"></div>
                <p class="text-secondary small italic font-monospace">Listening to agent event stream over SignalR...</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var evt in events.OrderBy(e => e.Timestamp))
                {
                    <div class="p-2 rounded-2 border border-secondary border-opacity-25" style="background: rgba(17, 24, 39, 0.7); border-left: 3px solid @GetEventColor(evt) !important;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge @GetBadgeClass(evt) font-monospace" style="font-size: 0.65rem;">
                                @evt.EventType
                            </span>
                            <small class="text-secondary font-monospace" style="font-size: 0.7rem;">
                                @evt.Timestamp.ToString("HH:mm:ss.fff")
                            </small>
                        </div>
                        <div class="text-light small text-break mt-1" style="white-space: pre-wrap; font-size: 0.8rem; line-height: 1.4;">
                            @GetEventSummary(evt)
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private HubConnection? hubConnection;
    private List<IAgentEvent> events = new();
    private HashSet<string> eventIds = new();
    private static readonly JsonSerializerOptions _jsonOptions = new() { PropertyNameCaseInsensitive = true };

    [Parameter] public EventCallback<dynamic> OnStateReceived { get; set; }

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/agentHub"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<JsonElement>("ReceiveEvent", (json) =>
        {
            AddEvent(json);
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await hubConnection.StartAsync();

            // Initial state load
            var state = await hubConnection.InvokeAsync<JsonElement>("GetInitialState");
            if (state.ValueKind != JsonValueKind.Null)
            {
                await OnStateReceived.InvokeAsync(state);

                JsonElement evtsJson;
                if (state.TryGetProperty("RecentEvents", out evtsJson) || state.TryGetProperty("recentEvents", out evtsJson))
                {
                    foreach (var item in evtsJson.EnumerateArray())
                    {
                        AddEvent(item);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR Connection Notice: {ex.Message}");
        }
    }

    private void ClearEvents()
    {
        events.Clear();
        eventIds.Clear();
    }

    private void AddEvent(JsonElement json)
    {
        try
        {
            string? eventType = null;
            if (json.TryGetProperty("EventType", out var typeProp) || json.TryGetProperty("eventType", out typeProp))
            {
                eventType = typeProp.GetString();
            }

            string? id = null;
            if (json.TryGetProperty("EventId", out var idProp) || json.TryGetProperty("eventId", out idProp))
            {
                id = idProp.GetString();
            }

            if (id != null && !eventIds.Add(id)) return;

            IAgentEvent? parsed = eventType switch
            {
                nameof(SessionStartedEvent) => JsonSerializer.Deserialize<SessionStartedEvent>(json.GetRawText(), _jsonOptions),
                nameof(UserPromptReceivedEvent) => JsonSerializer.Deserialize<UserPromptReceivedEvent>(json.GetRawText(), _jsonOptions),
                nameof(AgentThoughtEvent) => JsonSerializer.Deserialize<AgentThoughtEvent>(json.GetRawText(), _jsonOptions),
                nameof(ToolCalledEvent) => JsonSerializer.Deserialize<ToolCalledEvent>(json.GetRawText(), _jsonOptions),
                nameof(ToolResultEvent) => JsonSerializer.Deserialize<ToolResultEvent>(json.GetRawText(), _jsonOptions),
                nameof(FinalResponseGeneratedEvent) => JsonSerializer.Deserialize<FinalResponseGeneratedEvent>(json.GetRawText(), _jsonOptions),
                nameof(TaskAttemptStartedEvent) => JsonSerializer.Deserialize<TaskAttemptStartedEvent>(json.GetRawText(), _jsonOptions),
                nameof(TaskAttemptCompletedEvent) => JsonSerializer.Deserialize<TaskAttemptCompletedEvent>(json.GetRawText(), _jsonOptions),
                nameof(VerificationCompletedEvent) => JsonSerializer.Deserialize<VerificationCompletedEvent>(json.GetRawText(), _jsonOptions),
                nameof(DashboardCommandEvent) => JsonSerializer.Deserialize<DashboardCommandEvent>(json.GetRawText(), _jsonOptions),
                _ => new GenericAgentEvent(eventType ?? "GenericEvent", json.ToString())
            };

            if (parsed != null)
            {
                events.Add(parsed);
                if (events.Count > 100) events.RemoveAt(0);
            }
        }
        catch
        {
        }
    }

    private record GenericAgentEvent(string EventType, string RawJson) : IAgentEvent
    {
        public string EventId { get; init; } = Guid.NewGuid().ToString();
        public DateTime Timestamp { get; init; } = DateTime.UtcNow;
        public long Version { get; init; } = 1;
    }

    private string GetEventColor(IAgentEvent evt) => evt switch
    {
        ToolCalledEvent => "#00f0ff",
        ToolResultEvent r => !r.IsError ? "#10b981" : "#ef4444",
        AgentThoughtEvent => "#8b5cf6",
        UserPromptReceivedEvent => "#f59e0b",
        FinalResponseGeneratedEvent => "#10b981",
        VerificationCompletedEvent v => v.Verdict == "Pass" ? "#10b981" : "#ef4444",
        _ => "#6b7280"
    };

    private string GetBadgeClass(IAgentEvent evt) => evt switch
    {
        ToolCalledEvent => "badge-neon-cyan",
        ToolResultEvent r => !r.IsError ? "badge-neon-emerald" : "badge bg-danger",
        AgentThoughtEvent => "badge-neon-purple",
        UserPromptReceivedEvent => "badge-neon-amber",
        FinalResponseGeneratedEvent => "badge-neon-emerald",
        VerificationCompletedEvent v => v.Verdict == "Pass" ? "badge-neon-emerald" : "badge bg-danger",
        _ => "badge bg-secondary"
    };

    private string GetEventSummary(IAgentEvent evt) => evt switch
    {
        ToolCalledEvent tool => $"⚡ [TOOL EXECUTE] {tool.ToolName}\nArguments: {tool.Arguments}",
        ToolResultEvent res => $"✓ [TOOL RESULT] IsError: {res.IsError}\nResult: {res.Result}",
        AgentThoughtEvent thought => $"💭 [THINKING] {thought.Thought}",
        UserPromptReceivedEvent prompt => $"👤 [USER PROMPT] {prompt.Prompt}",
        FinalResponseGeneratedEvent resp => $"✨ [ASSISTANT] {resp.Response}",
        TaskAttemptStartedEvent task => $"🎯 [TASK START] #{task.AttemptNumber} Attempt: {task.AttemptId}",
        TaskAttemptCompletedEvent taskComp => $"🏁 [TASK COMPLETE] Status: {taskComp.Status}, Error: {taskComp.Error}",
        VerificationCompletedEvent ver => $"🛡️ [VERIFICATION] Verdict: {ver.Verdict} ({ver.PassedChecks}/{ver.TotalChecks} passed)",
        DashboardCommandEvent cmd => $"⌨️ [DASHBOARD COMMAND] {cmd.CommandName} -> Success: {cmd.Success}",
        GenericAgentEvent g => g.RawJson,
        _ => evt.ToString() ?? ""
    };

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
