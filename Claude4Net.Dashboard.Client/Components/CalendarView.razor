@using Claude4Net.SDK.Telemetry

<div class="cyber-card p-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-grid-3x3-gap-fill text-cyan" style="color: var(--neon-cyan);"></i>
            <h6 class="mb-0 fw-bold text-light">Antigravity AI 일별 토큰 활동 매트릭스 (90일 히트맵)</h6>
        </div>
        <div class="d-flex align-items-center gap-2 text-muted small font-monospace">
            <span>Less</span>
            <div class="d-flex gap-1 align-items-center">
                <span class="heatmap-tile intensity-0" style="width: 11px; height: 11px; border-radius: 2px; display: inline-block;"></span>
                <span class="heatmap-tile intensity-1" style="width: 11px; height: 11px; border-radius: 2px; display: inline-block;"></span>
                <span class="heatmap-tile intensity-2" style="width: 11px; height: 11px; border-radius: 2px; display: inline-block;"></span>
                <span class="heatmap-tile intensity-3" style="width: 11px; height: 11px; border-radius: 2px; display: inline-block;"></span>
                <span class="heatmap-tile intensity-4" style="width: 11px; height: 11px; border-radius: 2px; display: inline-block;"></span>
            </div>
            <span>More</span>
        </div>
    </div>

    <div class="row g-3">
        <!-- Left: Fully Aligned GitHub-Style 90-Day Contribution Heatmap -->
        <div class="col-12 col-xl-8">
            <div class="d-flex align-items-start gap-2 overflow-auto pb-2" style="scrollbar-width: thin;">
                @if (HeatmapTiles == null || HeatmapTiles.Count == 0)
                {
                    <div class="d-flex align-items-center justify-content-center w-100 py-4 text-muted small font-monospace">
                        <div class="spinner-border spinner-border-sm text-info me-2" role="status"></div>
                        <span>텔레메트리 히트맵 데이터를 수집하는 중...</span>
                    </div>
                }
                else
                {
                    <!-- Day-of-Week Labels on the left (일, 화, 목, 토) -->
                    <div class="d-flex flex-column text-muted font-monospace pe-1" style="font-size: 0.68rem; gap: 3px; margin-top: 22px; user-select: none;">
                        <span style="height: 13px; line-height: 13px;" class="text-danger">일</span>
                        <span style="height: 13px; line-height: 13px; opacity: 0;">월</span>
                        <span style="height: 13px; line-height: 13px;">화</span>
                        <span style="height: 13px; line-height: 13px; opacity: 0;">수</span>
                        <span style="height: 13px; line-height: 13px;">목</span>
                        <span style="height: 13px; line-height: 13px; opacity: 0;">금</span>
                        <span style="height: 13px; line-height: 13px;" class="text-info">토</span>
                    </div>

                    <!-- Week Columns with Month Header across top -->
                    <div class="d-flex gap-1">
                        @foreach (var week in _alignedWeeks)
                        {
                            <div class="heatmap-col" style="display: flex; flex-direction: column; gap: 3px;">
                                <!-- Month Header -->
                                <div style="height: 18px; font-size: 0.68rem; color: #94a3b8; line-height: 18px;" class="font-monospace text-nowrap">
                                    @(string.IsNullOrEmpty(week.MonthLabel) ? "\u00A0" : week.MonthLabel)
                                </div>

                                <!-- 7 Day Tiles (Sun=0 .. Sat=6) -->
                                @for (int dow = 0; dow < 7; dow++)
                                {
                                    var tile = week.Days[dow];
                                    @if (tile != null)
                                    {
                                        var isSelected = tile.DateIso == _selectedTile?.DateIso;
                                        <div class="heatmap-tile @GetIntensityClass(tile.IntensityLevel) @(isSelected ? "selected-tile" : "")"
                                             style="width: 13px; height: 13px; min-width: 13px; min-height: 13px; border-radius: 2px; cursor: pointer; transition: all 0.15s ease;"
                                             title="@($"{tile.DateIso} ({GetDayOfWeekKorean(dow)}): {tile.TotalTokens:N0} 토큰 (${tile.TotalCostUsd:F4} USD) [{(tile.RequestCount)}회 실행]")"
                                             @onclick="() => SelectTile(tile)">
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="width: 13px; height: 13px; min-width: 13px; min-height: 13px; opacity: 0;"></div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Detailed Selected Day Card -->
            @if (_selectedTile != null)
            {
                <div class="p-3 mt-3 rounded" style="background: rgba(14, 19, 28, 0.9); border: 1px solid rgba(0, 240, 255, 0.35); box-shadow: 0 0 15px rgba(0, 240, 255, 0.15);">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge badge-neon-cyan font-monospace px-2 py-1">선택 일자</span>
                            <h6 class="mb-0 text-light fw-bold font-monospace">@_selectedTile.DateIso</h6>
                            <span class="badge bg-dark border border-secondary border-opacity-50 text-muted font-monospace">@(_selectedTile.RequestCount)회 LLM 실행</span>
                        </div>
                        <div class="text-end">
                            <span class="small text-muted font-monospace me-1">예상 비용:</span>
                            <span class="text-success fw-bold font-monospace fs-6">$@_selectedTile.TotalCostUsd.ToString("F4") USD</span>
                        </div>
                    </div>

                    <div class="row g-2 text-center my-2">
                        <div class="col-4">
                            <div class="p-2 rounded bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                                <small class="text-muted d-block font-monospace">총 소모 토큰</small>
                                <span class="fs-5 fw-bold text-info font-monospace">@_selectedTile.TotalTokens.ToString("N0")</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 rounded bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                                <small class="text-muted d-block font-monospace">프롬프트 (입력)</small>
                                <span class="fs-5 fw-bold text-light font-monospace">@_selectedTile.PromptTokens.ToString("N0")</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 rounded bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                                <small class="text-muted d-block font-monospace">완성 (출력)</small>
                                <span class="fs-5 fw-bold text-emerald font-monospace" style="color: var(--neon-emerald);">@_selectedTile.CompTokens.ToString("N0")</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-10 small">
                        <div class="d-flex align-items-center gap-1">
                            <span class="text-muted font-monospace me-1">사용된 안티그래비티 모델:</span>
                            @if (_selectedTile.TopModels != null && _selectedTile.TopModels.Any())
                            {
                                @foreach (var m in _selectedTile.TopModels)
                                {
                                    <span class="badge badge-neon-purple font-monospace" style="font-size: 0.72rem;">@m</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted font-monospace">기록 없음</span>
                            }
                        </div>
                        <span class="text-muted font-monospace">
                            평균 레이턴시: <span class="text-light">@(_selectedTile.AvgLatencyMs > 0 ? $"{_selectedTile.AvgLatencyMs:F1}ms" : "N/A")</span>
                        </span>
                    </div>
                </div>
            }
        </div>

        <!-- Right: Hourly Activity Drilldown Panel -->
        <div class="col-12 col-xl-4">
            <div class="p-3 rounded h-100 d-flex flex-column justify-content-between" style="background: rgba(9, 12, 18, 0.75); border: 1px solid rgba(255,255,255,0.06);">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-bold text-light">당일 00:00 ~ 23:59 시간대별 토큰 소모</span>
                        <span class="badge badge-neon-cyan px-2 py-0 font-monospace" style="font-size: 0.68rem;">24 Hours</span>
                    </div>

                    <!-- SVG Hourly Area/Line Chart -->
                    <div style="height: 100px; width: 100%; position: relative;">
                        @if (HourlyBuckets != null && HourlyBuckets.Count > 0)
                        {
                            <svg viewBox="0 0 240 70" preserveAspectRatio="none" style="width: 100%; height: 100%;">
                                <defs>
                                    <linearGradient id="hourlyGrad" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#00f0ff" stop-opacity="0.45"/>
                                        <stop offset="100%" stop-color="#00f0ff" stop-opacity="0.0"/>
                                    </linearGradient>
                                </defs>
                                <polygon points="@GetHourlyPolygonPoints()" fill="url(#hourlyGrad)"/>
                                <polyline points="@GetHourlyPolylinePoints()" fill="none" stroke="#00f0ff" stroke-width="2"/>
                            </svg>
                            <div class="d-flex justify-content-between text-muted font-monospace" style="font-size: 0.65rem; margin-top: -5px;">
                                <span>00:00</span>
                                <span>06:00</span>
                                <span>12:00</span>
                                <span>18:00</span>
                                <span>23:00</span>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted small font-monospace">데이터 없음</div>
                        }
                    </div>
                </div>

                <!-- Top Projects Usage Share -->
                <div class="mt-3 pt-2 border-top border-secondary border-opacity-10">
                    <span class="small text-muted font-monospace d-block mb-1">프로젝트별 토큰 점유율</span>
                    @if (ProjectShares != null && ProjectShares.Count > 0)
                    {
                        @foreach (var p in ProjectShares.Take(3))
                        {
                            <div class="mb-1">
                                <div class="d-flex justify-content-between small text-muted font-monospace">
                                    <span class="text-truncate text-light" style="max-width: 160px;">@p.ProjectName</span>
                                    <span>@p.Percentage.ToString("F1")% (@p.TotalTokens.ToString("N0"))</span>
                                </div>
                                <div class="progress" style="height: 4px; background: rgba(255,255,255,0.05);">
                                    <div class="progress-bar" style="width: @(p.Percentage)%; background: var(--neon-cyan);"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small font-monospace">기록된 프로젝트가 없습니다.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .heatmap-tile.intensity-0 { background: #161b22; }
    .heatmap-tile.intensity-1 { background: #0e4429; }
    .heatmap-tile.intensity-2 { background: #006d32; }
    .heatmap-tile.intensity-3 { background: #26a641; }
    .heatmap-tile.intensity-4 { background: #39d353; box-shadow: 0 0 6px rgba(57, 211, 83, 0.4); }
    .heatmap-tile.selected-tile {
        outline: 2px solid #00f0ff;
        outline-offset: 1px;
        transform: scale(1.3);
        z-index: 10;
    }
</style>

@code {
    [Parameter] public List<CalendarHeatmapTileDto> HeatmapTiles { get; set; } = new();
    [Parameter] public List<HourlyUsageBucketDto> HourlyBuckets { get; set; } = new();
    [Parameter] public List<ProjectUsageShareDto> ProjectShares { get; set; } = new();
    [Parameter] public EventCallback<string> OnDateSelected { get; set; }

    private CalendarHeatmapTileDto? _selectedTile;
    private List<HeatmapWeek> _alignedWeeks = new();

    public class HeatmapWeek
    {
        public string MonthLabel { get; set; } = "";
        public List<CalendarHeatmapTileDto?> Days { get; set; } = new(); // 7 items (0=Sun .. 6=Sat)
    }

    protected override void OnParametersSet()
    {
        if (HeatmapTiles != null && HeatmapTiles.Count > 0)
        {
            _alignedWeeks = BuildAlignedWeeks(HeatmapTiles);

            if (_selectedTile == null)
            {
                // Default select latest tile (today)
                _selectedTile = HeatmapTiles.LastOrDefault();
            }
            else
            {
                // Preserve user selection by matching DateIso
                var match = HeatmapTiles.FirstOrDefault(t => t.DateIso == _selectedTile.DateIso);
                if (match != null)
                {
                    _selectedTile = match;
                }
            }
        }
    }

    private List<HeatmapWeek> BuildAlignedWeeks(List<CalendarHeatmapTileDto> source)
    {
        var weeks = new List<HeatmapWeek>();
        if (source == null || source.Count == 0) return weeks;

        var sorted = source.OrderBy(t => t.DateIso).ToList();
        if (sorted.Count == 0) return weeks;

        if (!DateTime.TryParse(sorted[0].DateIso, out var firstDate))
        {
            firstDate = DateTime.UtcNow.AddDays(-sorted.Count);
        }

        int startDayOfWeek = (int)firstDate.DayOfWeek; // 0=Sunday .. 6=Saturday

        var currentWeek = new HeatmapWeek();
        string lastMonth = "";

        // Pad beginning of first week if not starting on Sunday
        for (int i = 0; i < startDayOfWeek; i++)
        {
            currentWeek.Days.Add(null);
        }

        foreach (var tile in sorted)
        {
            if (currentWeek.Days.Count == 7)
            {
                weeks.Add(currentWeek);
                currentWeek = new HeatmapWeek();
            }

            if (DateTime.TryParse(tile.DateIso, out var d))
            {
                string monthName = $"{d.Month}월";
                if (d.Day <= 7 && monthName != lastMonth && string.IsNullOrEmpty(currentWeek.MonthLabel))
                {
                    currentWeek.MonthLabel = monthName;
                    lastMonth = monthName;
                }
            }

            currentWeek.Days.Add(tile);
        }

        // Pad end of last week up to Saturday (7 items)
        while (currentWeek.Days.Count < 7)
        {
            currentWeek.Days.Add(null);
        }
        weeks.Add(currentWeek);

        return weeks;
    }

    private async Task SelectTile(CalendarHeatmapTileDto? tile)
    {
        if (tile == null) return;
        _selectedTile = tile;
        StateHasChanged(); // Immediate local visual update

        if (OnDateSelected.HasDelegate)
        {
            await OnDateSelected.InvokeAsync(tile.DateIso);
        }
    }

    private string GetDayOfWeekKorean(int dow) => dow switch
    {
        0 => "일",
        1 => "월",
        2 => "화",
        3 => "수",
        4 => "목",
        5 => "금",
        6 => "토",
        _ => ""
    };

    private string GetIntensityClass(int level) => level switch
    {
        1 => "intensity-1",
        2 => "intensity-2",
        3 => "intensity-3",
        4 => "intensity-4",
        _ => "intensity-0"
    };

    private string GetHourlyPolylinePoints()
    {
        if (HourlyBuckets == null || HourlyBuckets.Count == 0) return "";
        long max = HourlyBuckets.Max(b => b.TotalTokens);
        if (max <= 0) max = 1;

        var points = new List<string>();
        for (int i = 0; i < HourlyBuckets.Count; i++)
        {
            double x = (i / 23.0) * 240.0;
            double norm = (double)HourlyBuckets[i].TotalTokens / max;
            double y = 70.0 - (norm * 60.0);
            points.Add($"{x:F1},{y:F1}");
        }
        return string.Join(" ", points);
    }

    private string GetHourlyPolygonPoints()
    {
        string poly = GetHourlyPolylinePoints();
        if (string.IsNullOrEmpty(poly)) return "";
        return $"0,70 {poly} 240,70";
    }
}
