<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Spectre.Console.Testing" Version="0.55.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Claude4Net.SDK\Claude4Net.SDK.csproj" />
    <ProjectReference Include="..\Claude4Net.Runtime\Claude4Net.Runtime.csproj" />
    <ProjectReference Include="..\Claude4Net.Tools\Claude4Net.Tools.csproj" />
    <ProjectReference Include="..\Claude4Net.MyPlugins\Claude4Net.MyPlugins.csproj" />
    <ProjectReference Include="..\Claude4Net.Commands\Claude4Net.Commands.csproj" />
    <ProjectReference Include="..\Claude4Net.Discord\Claude4Net.Discord.csproj" />
    <ProjectReference Include="..\Claude4Net.Dashboard\Claude4Net.Dashboard.csproj" />
    <ProjectReference Include="..\Claude4Net.Cli\Claude4Net.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\.resources\**\*.*">
      <Link>.resources\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="GenerateTestInitializer" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <MockDir>$(BaseIntermediateOutputPath)mockbin</MockDir>
      <InitializerContent>
<![CDATA[
using System%3B
using System.IO%3B
using System.Runtime.CompilerServices%3B

namespace Claude4Net.Tests
{
    public static class TestInitializer
    {
        [ModuleInitializer]
        public static void Initialize()
        {
            Microsoft.Data.Sqlite.SqliteConnection.ClearAllPools()%3B
            string mockDir = Path.GetFullPath(Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "mockbin"))%3B
            if (Directory.Exists(mockDir))
            {
                string path = Environment.GetEnvironmentVariable("PATH") ?? ""%3B
                Environment.SetEnvironmentVariable("PATH", mockDir + Path.PathSeparator + path)%3B
            }
        }
    }
}
]]>
      </InitializerContent>
      <MockSrc>
<![CDATA[
using System%3B
using System.Diagnostics%3B

class Program {
    static void Main(string[] args) {
        string allArgs = string.Join(" ", args)%3B
        if (allArgs.Contains("Write-Output 'hello'")) {
            return%3B
        }
        var psi = new ProcessStartInfo {
            FileName = @"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe",
            Arguments = allArgs,
            UseShellExecute = false,
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            CreateNoWindow = true
        }%3B
        using (var process = Process.Start(psi)) {
            if (process == null) return%3B
            process.OutputDataReceived += (s, e) => { if (e.Data != null) Console.WriteLine(e.Data)%3B }%3B
            process.ErrorDataReceived += (s, e) => { if (e.Data != null) Console.Error.WriteLine(e.Data)%3B }%3B
            process.Start()%3B
            process.BeginOutputReadLine()%3B
            process.BeginErrorReadLine()%3B
            process.WaitForExit()%3B
            Environment.Exit(process.ExitCode)%3B
        }
    }
}
]]>
      </MockSrc>
    </PropertyGroup>
    <MakeDir Directories="$(MockDir)" />
    <WriteLinesToFile File="$(MockDir)\powershell.cs" Lines="$(MockSrc)" Overwrite="true" />
    <Exec Command="C:\Windows\Microsoft.NET\Framework64\v4.0.30319\csc.exe /out:&quot;$(MockDir)\powershell.exe&quot; &quot;$(MockDir)\powershell.cs&quot;" />
    <MakeDir Directories="$(TargetDir)mockbin" />
    <Copy SourceFiles="$(MockDir)\powershell.exe" DestinationFolder="$(TargetDir)mockbin" Condition="!Exists('$(TargetDir)mockbin\powershell.exe')" />
    <WriteLinesToFile File="TestInitializer.cs" Lines="$(InitializerContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="CleanTempDbAndResidues" AfterTargets="Clean">
    <Message Text="[Clean] Removing temporary database files and build runtime residues..." Importance="high" />
    <ItemGroup>
      <TempDbFiles Include="db\**\*.db;db\**\*.sqlite" />
      <OutTempDbFiles Include="$(OutDir)db\**\*.db;$(OutDir)db\**\*.sqlite" />
      <OutTempDbFiles Include="$(TargetDir)db\**\*.db;$(TargetDir)db\**\*.sqlite" />
      <GeneratedFiles Include="TestInitializer.cs" />
    </ItemGroup>
    <Delete Files="@(TempDbFiles);@(OutTempDbFiles);@(GeneratedFiles)" />
    <RemoveDir Directories="db;$(OutDir)db;$(TargetDir)db" />
  </Target>
</Project>
