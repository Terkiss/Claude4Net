<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Claude4Net.SDK\Claude4Net.SDK.csproj" />
    <ProjectReference Include="..\Claude4Net.Runtime\Claude4Net.Runtime.csproj" />
    <ProjectReference Include="..\Claude4Net.Commands\Claude4Net.Commands.csproj" />
    <ProjectReference Include="..\Claude4Net.Discord\Claude4Net.Discord.csproj" />
    <!-- TeruTeruPandas는 MyPlugins의 의존성으로, 빌드 시 자동으로 메인 출력 폴더에 복사됩니다. -->
    <ProjectReference Include="..\Claude4Net.MyPlugins\Claude4Net.MyPlugins.csproj" Private="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.55.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- 빌드 후 '순수 플러그인 진입점'만 plugins 폴더로 이동/복사 -->
  <Target Name="CopyPlugins" AfterTargets="AfterBuild">
    <Message Text="[Auto-Build] Deploying Agent Plugins..." Importance="high" />
    <MakeDir Directories="$(OutDir)plugins" Condition="!Exists('$(OutDir)plugins')" />
    
    <!-- 오직 MyPlugins.dll만 plugins 폴더에 넣습니다. -->
    <Copy SourceFiles="$(OutDir)Claude4Net.MyPlugins.dll" 
          DestinationFolder="$(OutDir)plugins" 
          SkipUnchangedFiles="true" />
    
    <!-- 메인 폴더에 남은 원본은 삭제하지 않아도 무방하며, 
         plugins 폴더 안에는 의존성 라이브러리가 섞이지 않게 관리합니다. -->
    <Message Text="[Auto-Build] Plugin entry point successfully deployed to $(OutDir)plugins" Importance="high" />
  </Target>

</Project>
