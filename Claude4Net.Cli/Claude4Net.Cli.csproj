<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Claude4Net.SDK\Claude4Net.SDK.csproj" />
    <ProjectReference Include="..\Claude4Net.Runtime\Claude4Net.Runtime.csproj" />
    <ProjectReference Include="..\Claude4Net.Commands\Claude4Net.Commands.csproj" />
    <ProjectReference Include="..\Claude4Net.Discord\Claude4Net.Discord.csproj" />
    <ProjectReference Include="..\Claude4Net.MyPlugins\Claude4Net.MyPlugins.csproj" Private="true" />
    <ProjectReference Include="..\Claude4Net.Dashboard\Claude4Net.Dashboard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.55.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\.resources\**\*.*">
      <Link>.resources\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="AfterBuild">
    <Message Text="[Auto-Build] Deploying Agent Plugins..." Importance="high" />
    <MakeDir Directories="$(OutDir)plugins" Condition="!Exists('$(OutDir)plugins')" />
    <Copy SourceFiles="$(OutDir)Claude4Net.MyPlugins.dll" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" />
    <Message Text="[Auto-Build] Plugin entry point successfully deployed to $(OutDir)plugins" Importance="high" />
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Claude4Net.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="CleanTempDbAndResidues" AfterTargets="Clean">
    <Message Text="[Clean] Removing temporary database files and build runtime residues..." Importance="high" />
    <ItemGroup>
      <TempDbFiles Include="db\**\*.db;db\**\*.sqlite" />
      <OutTempDbFiles Include="$(OutDir)db\**\*.db;$(OutDir)db\**\*.sqlite" />
      <OutTempDbFiles Include="$(TargetDir)db\**\*.db;$(TargetDir)db\**\*.sqlite" />
    </ItemGroup>
    <Delete Files="@(TempDbFiles);@(OutTempDbFiles)" />
    <RemoveDir Directories="db;$(OutDir)db;$(TargetDir)db" />
  </Target>
</Project>
