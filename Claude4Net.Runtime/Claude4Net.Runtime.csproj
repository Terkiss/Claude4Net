<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Claude4Net.SDK\Claude4Net.SDK.csproj" />
    <ProjectReference Include="..\Claude4Net.Tools\Claude4Net.Tools.csproj" />
    <ProjectReference Include="..\TeruTeruPandas\TeruTeruPandas.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.55.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Claude4Net.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="CleanTempDbAndResidues" AfterTargets="Clean">
    <Message Text="[Clean] Removing temporary database files and build runtime residues..." Importance="high" />
    <ItemGroup>
      <TempDbFiles Include="db\**\*.db;db\**\*.sqlite" />
      <OutTempDbFiles Include="$(OutDir)db\**\*.db;$(OutDir)db\**\*.sqlite" />
      <OutTempDbFiles Include="$(TargetDir)db\**\*.db;$(TargetDir)db\**\*.sqlite" />
    </ItemGroup>
    <Delete Files="@(TempDbFiles);@(OutTempDbFiles)" />
    <RemoveDir Directories="db;$(OutDir)db;$(TargetDir)db" />
  </Target>
</Project>
