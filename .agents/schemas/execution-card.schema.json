{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionCard",
  "type": "object",
  "properties": {
    "task_id": { "type": "string" },
    "title": { "type": "string" },
    "objective": { "type": "string" },
    "intent": { "type": "string" },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "tier": { "type": "integer", "enum": [0, 1, 2, 3] },
    "source_of_truth": { "type": "string" },
    "target_skill": { "type": "string" },
    "scope": {
      "type": "object",
      "properties": {
        "allowed_files": { "type": "array", "items": { "type": "string" } },
        "forbidden_files": { "type": "array", "items": { "type": "string" } },
        "no_new_dependencies": { "type": "boolean" }
      },
      "required": ["allowed_files", "forbidden_files", "no_new_dependencies"]
    },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "non_requirements": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "verification_method": { "type": "string" }
        },
        "required": ["id", "description"]
      }
    },
    "verification": { "type": "string" },
    "evidence_required": { "type": "array", "items": { "type": "string" } },
    "rollback_or_mitigation": { "type": "string" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "blocking_questions": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "task_id",
    "title",
    "objective",
    "intent",
    "risk_level",
    "tier",
    "source_of_truth",
    "target_skill",
    "scope",
    "requirements",
    "non_requirements",
    "acceptance_criteria",
    "verification",
    "evidence_required",
    "rollback_or_mitigation",
    "assumptions",
    "blocking_questions"
  ]
}
